<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.JellyPlugShell</RootNamespace>
    <!-- Release source of truth; AssemblyVersion/FileVersion derive from it
         (JELA-64: pinning them made the dashboard report a stale version). -->
    <Version>1.0.57.0</Version>
    <!-- Minimum Jellyfin server ABI this build loads on. package-plugin.sh
         stamps it into the plugin's meta.json and the plugin-repo manifest
         entry (JELA-896: it used to be hardcoded to 10.11.0.0 in the script,
         so bumping Jellyfin.Controller here still shipped a zip that 12.0
         refused to load). Keep in lockstep with the PackageReference below. -->
    <JellyfinTargetAbi>12.0.0.0</JellyfinTargetAbi>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jint" Version="4.11.0" />
  </ItemGroup>

  <!-- TV-facing shell assets: embedded straight from the shell-tizen package so
       the plugin always serves the exact bytes the repo shipped/tested. -->
  <ItemGroup>
    <EmbeddedResource Include="../../shell-tizen/src/shell.min.js" Link="Resources/shell.min.js" LogicalName="JellyPlugShell.Resources.shell.min.js" />
    <EmbeddedResource Include="../../shell-tizen/src/babel.min.js" Link="Resources/babel.min.js" LogicalName="JellyPlugShell.Resources.babel.min.js" />
    <!-- JELA-67: JellyPlug Lite canvas home, served over the same /shell/
         rail (opt-in per TV via jellyfin.shell.liteEnabled, default OFF).
         The dist blob is committed; jellyplug-lite's dist-freshness test
         guards staleness. -->
    <EmbeddedResource Include="../../jellyplug-lite/dist/lite.min.js" Link="Resources/lite.min.js" LogicalName="JellyPlugShell.Resources.lite.min.js" />
  </ItemGroup>

  <!-- JELA-62: dashboard settings page (Plugin.GetPages resolves it as
       {RootNamespace}.Configuration.configPage.html, the msbuild default). -->
  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

  <!-- JELA-710: self-hosted webfonts. Google Fonts UA-sniffs the Tizen UA to
       TrueType (771 KiB/boot vs ~150 KiB of WOFF2) and puts two Google hosts
       serially on the boot path, so the WOFF2 bodies plus the two replacement
       stylesheets are embedded and served under /shell/fonts/. Regenerate the
       Inter/Sora/Archivo Narrow set with scripts/fetch-webfonts.py (upstream
       provenance is pinned in fonts-manifest.json, which is docs, not served).

       JELA-902: the same treatment for the NetFin skin, which the server's
       Branding.CustomCss @imports. That one field was the parent of 5.28 MB
       across 7 third-party requests per cold boot — 26% of the boot — most of
       it a single UNSUBSETTED 4-axis VARIABLE Material Symbols face (4,969,868
       B; M63 cannot drive the axes at all, so the whole gvar table was dead
       weight). netfin.css is vendored here with its css2 @import inlined and
       its icon src repointed at a static subset (-> 12,924 B), so the fielded
       skin makes zero third-party requests. Regenerate that set with
       scripts/build-netfin-fonts.mjs. Both globs below already cover the new
       files; guards live in scripts/netfin-fonts.test.cjs. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/fonts/*.woff2" LogicalName="JellyPlugShell.Resources.fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/fonts/*.css" LogicalName="JellyPlugShell.Resources.fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Server-side transform engine: the official @babel/standalone UMD at the
       exact version the vendored slim build was cut from (@babel/core 7.29.7,
       see the shell-tizen babel.min.js header). The slim chrome56 esbuild
       bundle needs native generators and does not run under Jint; the UMD
       build is ES5-compiled and does. Fetched at build time (pinned URL +
       sha256), never committed — see FetchBabelStandalone below. -->
  <PropertyGroup>
    <BabelStandaloneVersion>7.29.7</BabelStandaloneVersion>
    <BabelStandaloneSha256>7f55bd5c3efadeaa83d4de97dc91da8bf0733789801cf28b9273c4284739798e</BabelStandaloneSha256>
    <BabelStandaloneDir>$(MSBuildThisFileDirectory).cache/</BabelStandaloneDir>
    <BabelStandalonePath>$(BabelStandaloneDir)babel-standalone-$(BabelStandaloneVersion).min.js</BabelStandalonePath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(BabelStandalonePath)" Link="Resources/babel-transform.min.js" LogicalName="JellyPlugShell.Resources.babel-transform.min.js" />
  </ItemGroup>

  <Target Name="FetchBabelStandalone" BeforeTargets="PrepareForBuild" Condition="!Exists('$(BabelStandalonePath)')">
    <DownloadFile SourceUrl="https://unpkg.com/@babel/standalone@$(BabelStandaloneVersion)/babel.min.js" DestinationFolder="$(BabelStandaloneDir)" DestinationFileName="babel-standalone-$(BabelStandaloneVersion).min.js" />
  </Target>

  <Target Name="VerifyBabelStandalone" AfterTargets="FetchBabelStandalone" BeforeTargets="PrepareForBuild">
    <GetFileHash Files="$(BabelStandalonePath)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="BabelStandaloneHashed" />
    </GetFileHash>
    <Error Condition="'%(BabelStandaloneHashed.FileHash)' != '$(BabelStandaloneSha256)'" Text="babel-standalone download hash mismatch: got %(BabelStandaloneHashed.FileHash), expected $(BabelStandaloneSha256)" />
  </Target>

</Project>
